# systemd unit for the ban-pipeline server (server/ac_server.py).
#
# Install:
#   sudo useradd --system --no-create-home --user-group \
#       --shell /usr/sbin/nologin anticheat
#   # --user-group forces a same-name "anticheat" group to be created even
#   # when the distro's USERGROUPS_ENAB default is off (Group= below, and
#   # every chown/install command in these steps, depend on that group
#   # actually existing -- otherwise they fail on such a distro).
#   sudo install -d -m 0750 -o root -g anticheat /etc/anticheat
#   sudo install -d -m 0700 -o anticheat -g anticheat /var/lib/anticheat
#   # 0700/0750, not world-readable: /var/lib/anticheat holds the SQLite
#   # DB (bans + raw reports) and /etc/anticheat holds the auth keys.
#   # -n: only create it the first time -- these are install/upgrade steps
#   # meant to be re-run (e.g. after `git pull`), and unconditionally
#   # installing /dev/null over an existing env file would silently wipe
#   # out already-configured bearer keys on every re-run.
#   sudo test -e /etc/anticheat/ac_server.env || \
#       sudo install -m 640 -o root -g anticheat /dev/null /etc/anticheat/ac_server.env
#   sudo chown root:anticheat /etc/anticheat/ac_server.env
#   sudo chmod 640 /etc/anticheat/ac_server.env
#   sudo $EDITOR /etc/anticheat/ac_server.env   # AC_SERVER_REPORT_KEY=...
#                                                # AC_SERVER_ADMIN_KEY=...
#   sudo install -D -m 0755 server/ac_server.py /opt/anticheat/server/ac_server.py
#   sudo cp server/ac_server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ac_server
#
# Key rotation: add AC_SERVER_REPORT_KEY_OLD / AC_SERVER_ADMIN_KEY_OLD to
# the EnvironmentFile alongside the new AC_SERVER_REPORT_KEY /
# AC_SERVER_ADMIN_KEY, `systemctl restart ac_server`, roll every daemon
# and admin client over to the new keys, then remove the *_OLD lines and
# restart once more -- see the README's "Key rotation" section. This is a
# real `systemctl restart` (Type=simple, no socket activation) -- it
# avoids a coordinated cutover of every daemon/admin client, not a
# connection-level zero-downtime restart; a request during the brief
# stop/start gap is refused or times out same as any other restart.
#
# This binds to 127.0.0.1 by default (see ExecStart) -- pair with a TLS
# reverse proxy (README's "TLS" section) for anything reachable beyond
# localhost/LAN. When you do, drop --trust-proxy into a systemd override
# instead of editing ExecStart here directly (`sudo systemctl edit
# ac_server`, or a file at /etc/systemd/system/ac_server.service.d/
# proxy.conf), so rate limiting and the source_addr recorded on reports
# reflect the real client, not the proxy:
#
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/python3 /opt/anticheat/server/ac_server.py \
#       --host 127.0.0.1 --port 8787 --db /var/lib/anticheat/ac_server.db \
#       --trust-proxy
#
# (the empty `ExecStart=` first clears the unit's own default -- a
# systemd override *adds* to a multi-value directive by default, and two
# ExecStart= lines would try to run the server twice). Only enable this
# when a proxy you control is the sole path to this service and appends
# X-Forwarded-For (e.g. nginx's proxy_add_x_forwarded_for) -- see the
# README's `--trust-proxy` warning for why trusting it from anything else
# lets a client spoof both the rate-limit key and the audit trail.

[Unit]
Description=hypranticheat ban-pipeline server (ac_server.py)
After=network.target

[Service]
Type=simple
User=anticheat
Group=anticheat
EnvironmentFile=/etc/anticheat/ac_server.env
ExecStart=/usr/bin/python3 /opt/anticheat/server/ac_server.py \
    --host 127.0.0.1 --port 8787 --db /var/lib/anticheat/ac_server.db
# ac_server.py already turns SIGTERM into a clean ThreadingHTTPServer
# shutdown (see _handle_sigterm) -- this is systemd's default stop
# signal, so no KillSignal= override is needed.
Restart=on-failure
RestartSec=2s

# Sandboxing: this process only needs its own DB file and the network --
# nothing else on the system.
WorkingDirectory=/var/lib/anticheat
ReadWritePaths=/var/lib/anticheat
# Matches the 0700 state directory above: sqlite3's default create mode
# is world-readable, and ReadWritePaths= only grants filesystem access --
# it does nothing to the Unix permission bits new files are created
# with. Without this, the DB (and its WAL/SHM files) would be readable by
# any local user despite the directory itself being locked down.
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
